@article{RG_SG_MultiVertex_Yanagisawa_2021,
	title = {Renormalization group theory of generalized multi-vertex sine-{Gordon} model},
	volume = {2021},
	issn = {2050-3911},
	url = {http://arxiv.org/abs/2101.06020},
	doi = {10.1093/ptep/ptab026},
	abstract = {We investigate the renormalization group theory of generalized multi-vertex sine-Gordon model by employing the dimensional regularization method and also the Wilson renormalization group method. The vertex interaction is given by \${\textbackslash}cos(k\_j{\textbackslash}cdot {\textbackslash}phi)\$ where \$k\_j\$ (\$j=1,2,{\textbackslash}cdots,M\$) are momentum vectors and \${\textbackslash}phi\$ is an \$N\$-component scalar field. The beta functions are calculated for the sine-Gordon model with multi cosine interactions. The second-order correction in the renormalization procedure is given by the two-point scattering amplitude for tachyon scattering. We show that new vertex interaction with momentum vector \$k\_\{{\textbackslash}ell\}\$ is generated from two vertex interactions with vectors \$k\_i\$ and \$k\_j\$ when \$k\_i\$ and \$k\_j\$ meet the condition \$k\_\{{\textbackslash}ell\}=k\_i{\textbackslash}pm k\_j\$ called the triangle condition. Further condition \$k\_i{\textbackslash}cdot k\_j={\textbackslash}pm 1/2\$ is required within the dimensional regularization method. The renormalization group equations form a set of closed equations when \${\textbackslash}\{k\_j{\textbackslash}\}\$ form an equilateral triangle for \$N=2\$ or a regular tetrahedron for \$N=3\$. The Wilsonian renormalization group method gives qualitatively the same result for beta functions.},
	language = {en},
	number = {3},
	urldate = {2024-03-07},
	journal = {Progress of Theoretical and Experimental Physics},
	author = {Yanagisawa, Takashi},
	month = {03},
	year = {2021},
	keywords = {Condensed Matter - Statistical Mechanics, High Energy Physics - Theory},
	pages = {033A01},
	annote = {Comment: 10 pages},
	file = {Yanagisawa - 2021 - Renormalization group theory of generalized multi-.pdf:/home/ag_budich1/Zotero/storage/FJCKW2GX/Yanagisawa - 2021 - Renormalization group theory of generalized multi-.pdf:application/pdf},
}

